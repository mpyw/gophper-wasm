diff --git a/main/fastcgi.c b/main/fastcgi.c
index a393283f..bdd7ae9d 100644
--- a/main/fastcgi.c
+++ b/main/fastcgi.c
@@ -1279,7 +1279,11 @@ void fcgi_close(fcgi_request *req, int force, int destroy)
 		if (!force) {
 			char buf[8];
 
-			shutdown(req->fd, 1);
+			/* GOPHPER: 1 is SHUT_WR on POSIX systems, but SHUT_RD in WASI, which
+			 * numbers them from 1. Shutting reads made the drain below end at
+			 * once, and closing with the web server's last FCGI_STDIN unread
+			 * reset the connection, which lost the response. */
+			shutdown(req->fd, SHUT_WR);
 			/* read any remaining data, it may be omitted */
 			while (recv(req->fd, buf, sizeof(buf), 0) > 0) {}
 		}
